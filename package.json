{
  "name": "nexa-store",
  "version": "1.0.0",
  "private": true,
  "description": "NEXA STORE — Retail Management: API MySQL e frontend React",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "setup": "node scripts/seed.js",
    "seed": "node scripts/seed.js",
    "build": "npm --prefix frontend run build",
    "install:all": "npm install && npm --prefix frontend install",
    "check": "node --check server.js && node --check src/routes/sales.js && node --check src/routes/crud.js && node --check src/routes/reports.js && node --check scripts/seed.js",
    "verify": "node scripts/verify.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0"
  }
}
